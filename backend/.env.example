# Knowledge AI Backend Environment Variables
# Copy this file to .env and configure environment variables

# ═══════════════════════════════════════════════════════════════
# Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
# Keys come in two formats — both are valid:
#   Legacy: starts with "AIzaSy" (~39 chars)
#   New (2025+): starts with "AQ." (variable length)
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key_here

# Per-provider timeout in seconds
LLM_TIMEOUT_SECONDS=10

# ═══════════════════════════════════════════════════════════════
# Core Settings
# ═══════════════════════════════════════════════════════════════

# JWT Authentication Secret
SECRET_KEY=knowledge_ai_super_secret_jwt_key_2026_production

# Database URL
DATABASE_URL=sqlite:///./knowledge_ai.db

# Redis URL (Optional / Caching)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Search URL & Host
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# Storage & Upload Limits
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Embedding & Whisper Models
# NOTE: Embeddings use sentence-transformers locally — they are INDEPENDENT
# of the Gemini API key. Indexing/search works even if Gemini is down.
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=base

# Initial Admin Seed Credentials
ADMIN_SEED_EMAIL=vrajgoti07@gmail.com
ADMIN_SEED_PASSWORD=123456789
